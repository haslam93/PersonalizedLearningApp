@inherits LayoutComponentBase
@inject UpskillTracker.Services.DatabaseAvailabilityState DatabaseAvailabilityState

<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />
<a class="skip-link" href="#learning-content">Skip to learning content</a>

<MudLayout>
    <MudAppBar Elevation="0" Class="tracker-appbar">
        <MudAvatar Color="Color.Primary" Class="tracker-app-icon">
            <MudIcon Icon="@Icons.Material.Filled.School" />
        </MudAvatar>
        <MudStack Spacing="0" Class="ml-2">
            <MudText Typo="Typo.h6">Hammad's Learning Portal</MudText>
            <MudText Typo="Typo.caption" Class="mud-secondary-text">Focused learning workspace</MudText>
        </MudStack>
        <MudSpacer />
        <button type="button" class="theme-toggle" onclick="window.upskillTracker.toggleTheme()" aria-label="Toggle light and dark theme">
            <span class="theme-dark-label"><MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" /><span class="theme-toggle-text">Dark mode</span></span>
            <span class="theme-light-label"><MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" /><span class="theme-toggle-text">Light mode</span></span>
        </button>
    </MudAppBar>

    <MudMainContent>
        <PinGate>
            <div id="learning-content" class="shell-container" tabindex="-1">
                @if (DatabaseAvailabilityState.IsUnavailable)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4 database-status-banner">
                        <MudText Typo="Typo.subtitle2">Database offline</MudText>
                        <MudText Typo="Typo.body2">@DatabaseAvailabilityState.UserMessage</MudText>
                    </MudAlert>
                }

                @Body
            </div>
        </PinGate>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
