@using Microsoft.AspNetCore.Components.Authorization
@inject PinSessionService PinSessions

@if (ChildContent is null)
{
    @LoginForm
}
else
{
    <AuthorizeView Policy="@PinSessionService.Policy">
        <Authorized>
            <form id="portal-lock-form" method="post" action="/auth/pin/logout" data-enhance="false" class="portal-lock-bar">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Lock">
                    Lock portal
                </MudButton>
            </form>
            @if (_circuitReady)
            {
                @ChildContent
            }
            else
            {
                <div class="pin-gate-shell">
                    <MudPaper Class="pin-card pin-card-loading" Elevation="0">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        <MudText Typo="Typo.body1">Preparing your training hub...</MudText>
                    </MudPaper>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            @LoginForm
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ErrorCode { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    private bool _circuitReady;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && ChildContent is not null)
        {
            // Feature views use circuit navigation and JS; don't instantiate them during static prerender.
            _circuitReady = true;
            StateHasChanged();
        }
    }

    private string? ErrorMessage => !PinSessions.IsConfigured
        ? "PIN access is not configured. Contact the portal owner."
        : ErrorCode switch
        {
            "incorrect" => "Incorrect PIN. Try again.",
            "rate-limit" => "Too many attempts. Wait one minute before trying again.",
            "request" => "This form could not be verified. Please try again using the new form below.",
            _ => null
        };

    private RenderFragment LoginForm => @<main class="pin-gate-shell">
        <MudPaper Class="pin-card" Elevation="0">
            <MudStack Spacing="3">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Lock">
                    PIN protected
                </MudChip>
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h4">Enter your access PIN</MudText>
                    <MudText Typo="Typo.body1" Class="mud-secondary-text">
                        Use your personal PIN to open the tracker. Access expires after eight hours
                        or when you lock the portal.
                    </MudText>
                </MudStack>
                @if (ErrorMessage is { } message)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">
                        @message
                    </MudAlert>
                }
                <form method="post" action="/auth/pin/login" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@LocalReturnUrl.Normalize(ReturnUrl)" />
                    <MudStack Spacing="3">
                        <label for="access-pin">6-digit PIN</label>
                        <input id="access-pin"
                               name="pin"
                               type="password"
                               class="form-control"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               minlength="6"
                               maxlength="6"
                               autocomplete="off"
                               required
                               autofocus />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Disabled="@(!PinSessions.IsConfigured)">
                            Unlock hub
                        </MudButton>
                    </MudStack>
                </form>
                <MudText Typo="Typo.caption" Class="mud-secondary-text">
                    Your PIN is checked on the server and is never stored in your browser.
                </MudText>
            </MudStack>
        </MudPaper>
    </main>;
}
