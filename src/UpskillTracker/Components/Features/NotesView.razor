@inject UpskillTracker.Services.TrackerService TrackerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<NotesView> Logger

<div class="section-shell">
    <MudPaper Class="surface-card section-intro-card notes-intro-card mb-4" Elevation="0">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Class="text-uppercase section-kicker">Notes</MudText>
            <MudText Typo="Typo.h5">Capture decisions, lessons, and proof points fast</MudText>
            <MudText Typo="Typo.body2" Class="section-summary">
                Keep short structured notes near your plan so the dashboard and Copilot tab always have better context to work with.
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="surface-card content-card mb-4 notebook-bridge" Elevation="0">
        <MudText Typo="Typo.h6">Bring your learning notebook along</MudText>
        <MudText Typo="Typo.body2" Class="section-summary mb-3">Copy a saved takeaway, open OneNote, and paste it into your Learning page. This is a manual bridge, not background or two-way sync; no Graph permissions or cross-tenant data transfer.</MudText>
        @if (notebookResource is not null)
        {
            <a class="studio-text-link" href="@notebookResource.Url" target="_blank" rel="noopener noreferrer">Open learning notebook</a>
        }
        <details class="product-lab mt-3">
            <summary>Set your OneNote web link</summary>
                <MudTextField T="string" @bind-Value="notebookUrl" Label="OneNote notebook or Learning page web link" Variant="Variant.Outlined" MaxLength="500"
                              HelperText="Paste your SharePoint, OneNote, or OneDrive HTTPS link. It stays in the protected resource library, not in source code." />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3" OnClick="SaveNotebookAsync"
                           Disabled="@(savingNotebook || TrackerService.HasRecentTransientReadFailure)">Save notebook link</MudButton>
                <MudText Typo="Typo.caption" Class="section-summary">Manage or remove the saved link in Resources under Learning notebook.</MudText>
        </details>
        @if (exportText is not null)
        {
            <MudTextField T="string" Value="@exportText" Label="Note text to copy" Lines="6" ReadOnly="true" Variant="Variant.Outlined" Class="mt-3" />
        }
    </MudPaper>

<MudGrid Class="section-grid">
    <MudItem xs="12" lg="7">
        <MudPaper Class="surface-card content-card notes-library-card mb-4" Elevation="0">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-4">
                <MudTextField @bind-Value="searchText" Label="Search notes" Immediate="true" DebounceInterval="200" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-1" />
                <MudCheckBox @bind-Value="pinnedOnly" Label="Pinned only" Color="Color.Primary" />
            </MudStack>

            @if (!FilteredNotes.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No notes match. Clear your filters or capture a new takeaway.</MudAlert>
            }
            @foreach (var note in FilteredNotes)
            {
                <MudPaper @key="note.Id" Class="note-card mb-3" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.subtitle2">@note.Title</MudText>
                            <MudText Typo="Typo.caption" Class="mud-secondary-text">@note.Category • @note.RelatedArea • @note.Tags</MudText>
                        </div>
                        <MudStack Row="true" Spacing="1">
                            @if (note.IsPinned)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Color="Color.Primary" />
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => BeginEdit(note))">Edit</MudButton>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mt-3 preserve-lines">@note.Content</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyForNotebookAsync(note))">Copy for OneNote</MudButton>
                </MudPaper>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Class="surface-card content-card editor-card mb-4" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@(editingNote.Id == 0 ? "Add note" : "Edit note")</MudText>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="CreateNew">New</MudButton>
            </MudStack>

            <MudStack Spacing="2">
                <MudTextField @bind-Value="editingNote.Title" Label="Title" Variant="Variant.Outlined" Required="true" MaxLength="140" />
                <MudTextField @bind-Value="editingNote.Category" Label="Category" Variant="Variant.Outlined" MaxLength="80" />
                <MudTextField @bind-Value="editingNote.RelatedArea" Label="Related area" Variant="Variant.Outlined" MaxLength="120" />
                <MudTextField @bind-Value="editingNote.Tags" Label="Tags" Variant="Variant.Outlined" MaxLength="300" />
                <MudTextField @bind-Value="editingNote.Content" Label="Content" Variant="Variant.Outlined" Lines="8" Required="true" MaxLength="4000" />
                <MudCheckBox @bind-Value="editingNote.IsPinned" Label="Pinned" Color="Color.Primary" />
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save note</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CreateNew">Reset</MudButton>
                @if (editingNote.Id != 0)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync">Delete</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>
</div>

@code {
    private List<UpskillTracker.Models.NoteEntry> notes = [];
    private UpskillTracker.Models.NoteEntry editingNote = CreateEmptyNote();
    private string searchText = string.Empty;
    private bool pinnedOnly;
    private UpskillTracker.Models.ResourceEntry? notebookResource;
    private string notebookUrl = string.Empty;
    private string? exportText;
    private bool savingNotebook;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private IEnumerable<UpskillTracker.Models.NoteEntry> FilteredNotes => notes.Where(note =>
        (!pinnedOnly || note.IsPinned) &&
        (string.IsNullOrWhiteSpace(searchText) || note.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) || note.Content.Contains(searchText, StringComparison.OrdinalIgnoreCase) || note.Tags.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    private async Task LoadAsync()
    {
        notes = await TrackerService.GetNotesAsync();
        notebookResource = UpskillTracker.Services.LearningNotebookBridge.FindNotebook(await TrackerService.GetResourcesAsync());
        notebookUrl = notebookResource?.Url ?? string.Empty;
        if (editingNote.Id != 0)
        {
            var refreshed = notes.FirstOrDefault(note => note.Id == editingNote.Id);
            if (refreshed is not null)
            {
                BeginEdit(refreshed);
            }
        }
    }

    private void BeginEdit(UpskillTracker.Models.NoteEntry note)
    {
        editingNote = note.Clone();
    }

    private async Task SaveNotebookAsync()
    {
        var url = notebookUrl.Trim();
        if (!UpskillTracker.Services.LearningNotebookBridge.IsValidNotebookUrl(url))
        {
            Snackbar.Add("Use a OneNote, SharePoint, or OneDrive HTTPS web link of at most 500 characters.", Severity.Warning);
            return;
        }

        savingNotebook = true;
        try
        {
            var resource = notebookResource?.Clone() ?? new UpskillTracker.Models.ResourceEntry
            {
                Title = "My OneNote learning notebook",
                Section = "Learning notebook",
                Kind = UpskillTracker.Models.ResourceKind.Other,
                Tags = UpskillTracker.Services.LearningNotebookBridge.ResourceTag,
                Summary = "Private notebook shortcut. Copy learning notes manually; no automatic sync."
            };
            resource.Url = url;
            await TrackerService.SaveResourceAsync(resource);
            notebookResource = resource;
            Snackbar.Add("Notebook link saved. No notebook content has been read or sent.", Severity.Success);
        }
        catch (UpskillTracker.Services.TrackerStorageUnavailableException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally { savingNotebook = false; }
    }

    private async Task CopyForNotebookAsync(UpskillTracker.Models.NoteEntry note)
    {
        var text = UpskillTracker.Services.LearningNotebookBridge.BuildNoteText(
            note, Navigation.ToAbsoluteUri("?view=notes").AbsoluteUri);
        exportText = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("upskillTracker.copyText", text);
            Snackbar.Add("Note copied. Open your learning notebook and paste it; OneNote has not been changed automatically.", Severity.Success);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Clipboard access failed for a learning note.");
            exportText = text;
            Snackbar.Add("Clipboard access is unavailable. Select and copy the displayed note text.", Severity.Warning);
        }
    }

    private void CreateNew()
    {
        editingNote = CreateEmptyNote();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editingNote.Title) || string.IsNullOrWhiteSpace(editingNote.Content))
        {
            Snackbar.Add("Title and content are required.", Severity.Warning);
            return;
        }

        try
        {
            await TrackerService.SaveNoteAsync(editingNote);
            Snackbar.Add("Note saved.", Severity.Success);
            await LoadAsync();
            CreateNew();
        }
        catch (UpskillTracker.Services.TrackerStorageUnavailableException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task DeleteAsync()
    {
        if (editingNote.Id == 0)
        {
            return;
        }

        if (await DialogService.ShowMessageBox("Delete this note?", "The note will be removed. Its existing learning history will remain.",
            yesText: "Delete note", cancelText: "Keep note") != true)
        {
            return;
        }

        try
        {
            await TrackerService.DeleteNoteAsync(editingNote.Id);
            Snackbar.Add("Note deleted.", Severity.Info);
            await LoadAsync();
            CreateNew();
        }
        catch (UpskillTracker.Services.TrackerStorageUnavailableException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private static UpskillTracker.Models.NoteEntry CreateEmptyNote()
    {
        return new UpskillTracker.Models.NoteEntry();
    }
}
