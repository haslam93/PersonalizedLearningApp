@page "/"
@inject UpskillTracker.Services.TrackerService TrackerService
@inject NavigationManager Navigation

<PageTitle>Hammad's Learning Portal</PageTitle>

<h1 class="sr-only">Hammad's Learning Portal</h1>

@if (TrackerService.HasRecentTransientReadFailure)
{
	<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
		@TrackerService.DatabaseUnavailableMessage
	</MudAlert>
}

<MudTabs ActivePanelIndex="@activeTabIndex" ActivePanelIndexChanged="SelectTabAsync" MinimumTabWidth="100px" Elevation="0" Rounded="true" PanelClass="pt-6" Class="tracker-tabs">
	<MudTabPanel Text="Dashboard" Icon="@Icons.Material.Filled.Dashboard">
		<DashboardView LearningSession="@learningSession" OnOpenPlan="NavigateToPlanAsync" OnOpenHistory="NavigateToHistoryAsync" OnOpenHistoryDate="NavigateToHistoryDateAsync" />
	</MudTabPanel>
	<MudTabPanel Text="Products" Icon="@Icons.Material.Filled.Category">
		<ProductLearningView OnChooseLearning="ChooseLearningAsync" />
	</MudTabPanel>
	<MudTabPanel Text="Plan" Icon="@Icons.Material.Filled.Checklist">
		<TrainingPlannerView NavigationRequest="@planNavigationRequest" NavigationRequestId="@planNavigationToken" />
	</MudTabPanel>
	<MudTabPanel Text="Certifications" Icon="@Icons.Material.Filled.WorkspacePremium">
		<CertificationsView />
	</MudTabPanel>
	<MudTabPanel Text="Timeline" Icon="@Icons.Material.Filled.Timeline">
		<TimelineView OnOpenPlan="NavigateToPlanAsync" />
	</MudTabPanel>
	<MudTabPanel Text="History" Icon="@Icons.Material.Filled.AutoGraph">
		<LearningHistoryView RequestedDate="@historyRequestedDate" NavigationRequestId="@historyNavigationToken" />
	</MudTabPanel>
	<MudTabPanel Text="My Tools" Icon="@Icons.Material.Filled.BuildCircle">
		<LearningToolsView />
	</MudTabPanel>
	<MudTabPanel Text="Resources" Icon="@Icons.Material.Filled.LibraryBooks">
		<ResourcesView />
	</MudTabPanel>
	<MudTabPanel Text="Videos" Icon="@Icons.Material.Filled.OndemandVideo">
		<VideosView />
	</MudTabPanel>
	<MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.StickyNote2">
		<NotesView />
	</MudTabPanel>
	<MudTabPanel Text="Copilot" Icon="@Icons.Material.Filled.SmartToy">
		<CopilotChatView />
	</MudTabPanel>
</MudTabs>

@code {
	[SupplyParameterFromQuery(Name = "view")]
	public string? RequestedView { get; set; }

	private static readonly string[] TabKeys = ["dashboard", "products", "plan", "certifications", "timeline", "history", "tools", "resources", "videos", "notes", "copilot"];
	private string? appliedView;
	private readonly UpskillTracker.Models.LearningStudioSession learningSession = new();
	private int activeTabIndex;
	private int planNavigationToken;
	private int historyNavigationToken;
	private DateTime? historyRequestedDate;
	private UpskillTracker.Models.PlanNavigationRequest planNavigationRequest = new("Do next");

	protected override void OnParametersSet()
	{
		var view = RequestedView?.ToLowerInvariant() ?? "dashboard";
		if (appliedView != view)
		{
			appliedView = view;
			activeTabIndex = Math.Max(0, Array.IndexOf(TabKeys, view));
		}
	}

	private Task SelectTabAsync(int index)
	{
		activeTabIndex = Math.Clamp(index, 0, TabKeys.Length - 1);
		var uri = Navigation.GetUriWithQueryParameter("view", activeTabIndex == 0 ? null : TabKeys[activeTabIndex]);
		Navigation.NavigateTo(uri);
		return Task.CompletedTask;
	}

	private Task NavigateToPlanAsync(UpskillTracker.Models.PlanNavigationRequest request)
	{
		planNavigationRequest = request;
		planNavigationToken++;
		return SelectTabAsync(Array.IndexOf(TabKeys, "plan"));
	}

	private Task ChooseLearningAsync(int id)
	{
		learningSession.FocusItemId = id;
		learningSession.StartMessage = null;
		return SelectTabAsync(0);
	}

	private Task NavigateToHistoryAsync()
	{
		historyRequestedDate = null;
		historyNavigationToken++;
		return SelectTabAsync(Array.IndexOf(TabKeys, "history"));
	}

	private Task NavigateToHistoryDateAsync(DateTime date)
	{
		historyRequestedDate = date.Date;
		historyNavigationToken++;
		return SelectTabAsync(Array.IndexOf(TabKeys, "history"));
	}
}
